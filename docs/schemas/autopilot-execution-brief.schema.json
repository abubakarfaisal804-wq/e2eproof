{
  "$defs": {
    "ActionKind": {
      "enum": [
        "observe",
        "score",
        "persist_state",
        "generate_execution_brief",
        "run_read_only_checks",
        "modify_application_code",
        "open_or_merge_pull_request",
        "send_email",
        "deploy",
        "publish_release",
        "change_credentials",
        "spend_money",
        "change_pricing_or_billing",
        "make_legal_commitment",
        "access_customer_production_data",
        "destructive_migration",
        "change_security_control",
        "force_push",
        "rewrite_protected_history"
      ],
      "title": "ActionKind",
      "type": "string"
    },
    "FactKind": {
      "enum": [
        "verified",
        "estimate",
        "hypothesis"
      ],
      "title": "FactKind",
      "type": "string"
    },
    "JsonValue": {},
    "Observation": {
      "additionalProperties": false,
      "properties": {
        "category": {
          "maxLength": 80,
          "minLength": 2,
          "title": "Category",
          "type": "string"
        },
        "evidence_url": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Url"
        },
        "kind": {
          "$ref": "#/$defs/FactKind"
        },
        "observation_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,149}$",
          "title": "Observation Id",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "source": {
          "maxLength": 160,
          "minLength": 2,
          "title": "Source",
          "type": "string"
        },
        "summary": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        }
      },
      "required": [
        "observation_id",
        "observed_at",
        "kind",
        "category",
        "source",
        "summary"
      ],
      "title": "Observation",
      "type": "object"
    },
    "OwnerApprovalStatus": {
      "additionalProperties": false,
      "properties": {
        "approval_ids": {
          "items": {
            "type": "string"
          },
          "title": "Approval Ids",
          "type": "array"
        },
        "missing_scopes": {
          "items": {
            "$ref": "#/$defs/PolicyTag"
          },
          "title": "Missing Scopes",
          "type": "array"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "satisfied": {
          "title": "Satisfied",
          "type": "boolean"
        }
      },
      "required": [
        "required",
        "satisfied",
        "approval_ids",
        "missing_scopes"
      ],
      "title": "OwnerApprovalStatus",
      "type": "object"
    },
    "PolicyTag": {
      "enum": [
        "spending",
        "paid_infrastructure",
        "credentials",
        "secrets",
        "pricing",
        "billing",
        "legal",
        "customer_production_data",
        "release",
        "deployment",
        "destructive_migration",
        "branch_protection",
        "security_controls",
        "force_push",
        "protected_history_rewrite"
      ],
      "title": "PolicyTag",
      "type": "string"
    },
    "RiskLevel": {
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "title": "RiskLevel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "acceptance_criteria": {
      "items": {
        "type": "string"
      },
      "title": "Acceptance Criteria",
      "type": "array"
    },
    "affected_area": {
      "title": "Affected Area",
      "type": "string"
    },
    "dry_run": {
      "default": true,
      "title": "Dry Run",
      "type": "boolean"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Observation"
      },
      "title": "Evidence",
      "type": "array"
    },
    "expected_impact": {
      "title": "Expected Impact",
      "type": "string"
    },
    "objective": {
      "title": "Objective",
      "type": "string"
    },
    "owner_approval": {
      "$ref": "#/$defs/OwnerApprovalStatus"
    },
    "permitted_actions": {
      "items": {
        "$ref": "#/$defs/ActionKind"
      },
      "title": "Permitted Actions",
      "type": "array"
    },
    "prohibited_actions": {
      "items": {
        "$ref": "#/$defs/ActionKind"
      },
      "title": "Prohibited Actions",
      "type": "array"
    },
    "required_tests": {
      "items": {
        "type": "string"
      },
      "title": "Required Tests",
      "type": "array"
    },
    "risk_level": {
      "$ref": "#/$defs/RiskLevel"
    },
    "schema_version": {
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "suggested_branch": {
      "title": "Suggested Branch",
      "type": "string"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "objective",
    "evidence",
    "expected_impact",
    "acceptance_criteria",
    "affected_area",
    "required_tests",
    "suggested_branch",
    "risk_level",
    "permitted_actions",
    "prohibited_actions",
    "owner_approval"
  ],
  "title": "ExecutionBrief",
  "type": "object"
}
